{
  "name": "michaelmvh.github.io",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "a11y": "playwright test",
    "build": "node scripts/build.ts",
    "check": "npm run typecheck && npm run validate && npm run build && npm run html:check && npm test && npm run a11y",
    "dev": "node scripts/serve.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "html:check": "html-validate \"dist/**/*.html\"",
    "sync:cv": "node scripts/sync-cv.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "archyne": "1.0.0-alpha.1",
    "esbuild": "0.28.2",
    "html-validate": "11.16.1",
    "jsqr": "1.4.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "qrcode-generator": "2.0.4"
  }
}
